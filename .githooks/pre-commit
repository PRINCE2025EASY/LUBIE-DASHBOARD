#!/bin/sh
# Refuses a commit that would publish a secret. Enabled with: git config core.hooksPath .githooks
fail=0
if git diff --cached --name-only | grep -qE '(^|/)\.env$'; then
  echo "pre-commit: .env must never be committed." >&2; fail=1
fi
if git diff --cached --name-only | grep -qx '.env.example'; then
  if git show :.env.example | tr -d '\r' | grep -qE '^(APP_KEY|DB_PASSWORD|SMS_API_KEY|BACKUP_ENCRYPTION_KEY|BACKUP_TOKEN|DB_SSL_CA_PEM)=.+'; then
    echo "pre-commit: .env.example contains a password or key. Put real values in .env only." >&2; fail=1
  fi
fi
if git diff --cached -U0 | grep -qE '^\+.*(AVNS_[A-Za-z0-9_-]{8,}|ghp_[A-Za-z0-9]{20,}|-----BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY)'; then
  echo "pre-commit: a token or private key is in the staged changes." >&2; fail=1
fi
exit $fail
