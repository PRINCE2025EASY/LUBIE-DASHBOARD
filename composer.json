{
    "name": "lubie/monitoring-dashboard",
    "description": "Lubie Construction Works real-time project monitoring dashboard (MSc prototype)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-fileinfo": "*",
        "dompdf/dompdf": "3.1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.57"
    },
    "suggest": {
        "ext-curl": "HTTP SMS adapter (Arkesel-compatible)",
        "ext-zlib": "Compressed backups",
        "ext-gd": "Progress photo re-encoding (Iteration 3)"
    },
    "autoload": {
        "psr-4": { "Lubie\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Lubie\\Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.2.12" },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "lint": "php bin/lint.php"
    }
}
