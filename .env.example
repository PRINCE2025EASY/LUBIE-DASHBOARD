# Lubie dashboard configuration. Copy this file to .env and fill in your own values.
# Never commit .env. Never paste these values into chat or email.
# On a host, set the same names in the host's environment or secret settings instead.

# local | staging | production
APP_ENV=local
# 1 shows PHP errors on screen (local only). Keep 0 everywhere else.
APP_DEBUG=0
# Random secret, 32+ characters. Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=
# Sub-folder the app is served from. XAMPP: /lubie-dashboard   Host at domain root: leave empty.
APP_BASE_PATH=/lubie-dashboard
# Testing only: freeze the clock, for example 2026-10-21 09:00:00. Leave empty in real use.
APP_FIXED_NOW=

# Database (least-privilege application account, not root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lubie_dashboard
DB_USER=lubie_app
DB_PASSWORD=
# Test database used by the automated tests (must end in _test)
DB_TEST_NAME=lubie_dashboard_test
# Managed cloud databases: path to the provider's CA certificate. Empty on XAMPP.
DB_SSL_CA=
DB_SSL_VERIFY=1
DB_CONNECT_RETRIES=3

# 1 when the site runs over HTTPS (online host). 0 on plain http://localhost.
SESSION_SECURE_COOKIE=0

# SMS: sandbox (logs only, sends nothing) or arkesel (real provider, paid credits)
SMS_PROVIDER=sandbox
SMS_BASE_URL=
SMS_API_KEY=
# Sender ID approved by the provider, up to 11 characters
SMS_SENDER_ID=

# Backups: encryption key, 32+ characters. Store a copy offline. Without it backups cannot be read.
BACKUP_ENCRYPTION_KEY=
# Token for the external scheduler calling /api/v1/backup/run (32+ random characters)
BACKUP_TOKEN=
