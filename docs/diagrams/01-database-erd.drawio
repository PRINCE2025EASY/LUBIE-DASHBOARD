<mxCell id="erdE_rules_98" value="Rules: one setting per (scope, key) via generated scope_project_id; min_allowed &amp;lt;= max_allowed; only one OPEN alert per dedup_key (generated open_dedup_key); resolved requires cleared_at; one recipient row per (alert, user); audit_logs append-only (DB grant: SELECT, INSERT only)." style="html=1;shape=note;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;size=14;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2190" y="330" width="300" height="240" as="geometry"/></mxCell>
