<mxCell id="cp3_n3_25" value="Free tiers can sleep (cold start), have ephemeral disks and may lack cron; the design is stateless (DB sessions, streamed exports, external scheduler) so these limits do not lose data. Free tiers suit a thesis prototype, not long-term production." style="html=1;shape=note;size=14;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1740" y="260" width="420" height="170" as="geometry"/></mxCell>
