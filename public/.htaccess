# Front controller routing; static assets are served directly.
Options -Indexes -MultiViews
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [QSA,L]
</IfModule>
<IfModule mod_headers.c>
    # Images and fonts change rarely. CSS and JS are revalidated on every load (a quick 304),
    # because JavaScript modules are imported without a version query.
    <FilesMatch "\.(woff2|png|jpg|webp|ico|svg)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.(css|js|webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
